# 既定: リポジトリ内は LF、チェックアウト時は環境に合わせる
* text=auto

# Windows 用のスクリプトは作業コピーを必ず CRLF にする
# (cmd.exe は LF だけの .bat でラベル/goto を誤読することがある)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# シェルスクリプトは必ず LF にする
# (CRLF だと shebang の解釈に失敗し、ヒアドキュメントの終端も一致しなくなる)
*.sh text eol=lf

# テストのフィクスチャは両 OS で同じ内容を保ちたいので改行変換しない
test/fixtures/projects/** -text
